{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "server",
        "--prefix",
        "app"
      ],
      "port": 3001
    },
    {
      "name": "client",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "app/client",
        "--",
        "--port",
        "3000",
        "--strictPort"
      ],
      "port": 3000
    },
    {
      "name": "api-github-app",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "PORT=3101",
        "GITHUB_APP_ID=1",
        "GITHUB_APP_SLUG=takeoff-dev",
        "GITHUB_APP_CLIENT_ID=placeholder",
        "GITHUB_APP_CLIENT_SECRET=placeholder",
        "GITHUB_APP_PRIVATE_KEY=placeholder",
        "npm",
        "run",
        "server",
        "--prefix",
        "/Users/samyak/CodeGuru-github-app/app"
      ],
      "port": 3101
    },
    {
      "name": "client-github-app",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "API_URL=http://localhost:3101",
        "npm",
        "run",
        "dev",
        "--prefix",
        "/Users/samyak/CodeGuru-github-app/app/client",
        "--",
        "--port",
        "3100",
        "--strictPort"
      ],
      "port": 3100
    }
  ]
}
